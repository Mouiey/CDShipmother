      <DecorativeSprite texture="%ModDir%/content/png/Gambling.png" sourcerect="142,179,82,32" origin="0.5,2.77" depth="0.598">
        <Conditional HasStatusTag="cd_slotmachine_jackpot" />
      </DecorativeSprite>
      <!-- display - win -->
