        <Conditional HasStatusTag="cd_slotmachine_lose" />
      </DecorativeSprite>
      <!-- single decorative sprite to simulate rotating slots -->
      <DecorativeSprite texture="%ModDir%/content/png/Gambling.png" sourcerect="303,0,86,75" depth="0.599" origin="0.5,0.2" offset="0,110" offsetanim="Noise" offsetanimspeed="20.0">
        <AnimationConditional HasStatusTag="cd_slotmachine_rolling" />
        <IsActiveConditional HasStatusTag="cd_slotmachine_rolling" />
      </DecorativeSprite>
      <Controller canbeselected="true" selectkey="Select" hidehud="false" issecondaryitem="false" drawuserbehind="false" AllowSelectingWhenSelectedByOther="false" />
      <!-- Keep the play button mounted in a stable frame above the inventory. -->
      <CustomInterface canbeselected="true" selectkey="Select" drawhud="false">
        <!-- The wager Containable applies the cd_slotmachine_hasbet tag to the machine while slot 0 contains cd1000MK.
             ItemComponent conditionals hide this interface (and therefore Play) until a wager exists. -->
        <Conditional HasStatusTag="cd_slotmachine_hasbet" />
        <GuiFrame style="ItemUI" absoluteoffset="0,-230" anchor="BottomCenter" relativesize="0.16,0.08" />
        <Button text="Play">
          <!-- Lock the machine while all three reels are rolling. -->
          <StatusEffect type="OnUse" target="This" StatusEffectTags="cd_slotmachine_rolling" duration="4.1" nonplayerteaminteractable="True" setvalue="true" disabledeltatime="true">
            <RequiredItem items="cd1000MK" type="Contained" />
            <Conditional HasStatusTag="!equals cd_slotmachine_payoutpending" />
            <Conditional HasStatusTag="!equals cd_slotmachine_rolling" />
          </StatusEffect>
          <!-- Restore normal player interaction exactly when the spin lock expires. -->
          <StatusEffect type="OnUse" target="This" delay="4.1" duration="0.1" nonplayerteaminteractable="False" setvalue="true" disabledeltatime="true" />
          <StatusEffect type="OnUse" target="This" duration="3">
