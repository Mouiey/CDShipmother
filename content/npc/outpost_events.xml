  <!--银行业务-->
  <EventPrefabs>
    <ScriptedEvent identifier="cdbankevent" commonness="100">
      <TagAction criteria="player" tag="player" />
      <SpawnAction npcsetidentifier="cdspecialnpc" npcidentifier="cdbanker" targettag="cdbanker" spawnlocation="Outpost" targetmoduletags="airlock" />
      <StatusEffectAction targettag="cdbanker">
        <StatusEffect target="This" UseHealthWindow="false" />
      </StatusEffectAction>
      <Label name="beginningofthejourney" />
      <NPCWaitAction npctag="cdbanker" wait="false" />
      <TriggerAction target1tag="cdbanker" target2tag="player" applytotarget2="triggerer_player" radius="200" waitforinteraction="true" />
      <ConversationAction targettag="triggerer_player" text="欢迎使用沉底银行，需要什么服务吗？">
        <Option text="取款服务">
          <ConversationAction targettag="triggerer_player" text="感谢使用取款服务，本服务将为你兑现你的银行额度，请选择取款金额">
            <Option text="取出一万马克">
              <CheckReputationAction targettype="faction" identifier="cdbank" condition="gte -50">
                <Success>
                  <ReputationAction targettype="Faction" identifier="cdbank" increase="-1" />
                  <ConversationAction targettag="triggerer_player" text="这是您的钱，请收好，欢迎下次再来" />
                  <SpawnAction itemidentifier="cd10000MK" targetinventory="triggerer_player" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Success>
                <Failure>
                  <ConversationAction targettag="triggerer_player" text="对不起，您的信用已严重透支，本行拒绝服务" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Failure>
              </CheckReputationAction>
            </Option>
            <Option text="取出五万马克">
              <CheckReputationAction targettype="faction" identifier="cdbank" condition="gte -50">
                <Success>
                  <ReputationAction targettype="Faction" identifier="cdbank" increase="-5" />
                  <ConversationAction targettag="triggerer_player" text="这是您的钱，请收好，欢迎下次再来" />
                  <SpawnAction itemidentifier="cd10000MK" targetinventory="triggerer_player" />
                  <SpawnAction itemidentifier="cd10000MK" targetinventory="triggerer_player" />
                  <SpawnAction itemidentifier="cd10000MK" targetinventory="triggerer_player" />
                  <SpawnAction itemidentifier="cd10000MK" targetinventory="triggerer_player" />
                  <SpawnAction itemidentifier="cd10000MK" targetinventory="triggerer_player" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Success>
                <Failure>
                  <ConversationAction targettag="triggerer_player" text="对不起，您的信用已严重透支，本行拒绝服务" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Failure>
              </CheckReputationAction>
            </Option>
            <Option text="取出十万马克">
              <CheckReputationAction targettype="faction" identifier="cdbank" condition="gte -50">
                <Success>
                  <ReputationAction targettype="Faction" identifier="cdbank" increase="-10" />
                  <ConversationAction targettag="triggerer_player" text="这是您的钱，请收好，欢迎下次再来" />
                  <SpawnAction itemidentifier="cd100000MK" targetinventory="triggerer_player" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Success>
                <Failure>
                  <ConversationAction targettag="triggerer_player" text="对不起，您的信用已严重透支，本行拒绝服务" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Failure>
              </CheckReputationAction>
            </Option>
          </ConversationAction>
        </Option>
        <Option text="存款服务">
          <ConversationAction targettag="triggerer_player" text="感谢使用存款服务，本服务使用马克为您换取银行额度，请选择存款金额">
            <Option text="存款一万马克">
              <CheckMoneyAction amount="10000">
                <Success>
                  <MoneyAction amount="-10000" />
                  <ReputationAction targettype="Faction" identifier="cdbank" increase="1" />
                  <ConversationAction targettag="triggerer_player" text="存款成功，感谢您使用本银行" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Success>
                <Failure>
                  <ConversationAction targettag="triggerer_player" text="您的钱好像不够呢" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Failure>
              </CheckMoneyAction>
            </Option>
            <Option text="存款五万马克">
              <CheckMoneyAction amount="50000">
                <Success>
                  <MoneyAction amount="-50000" />
                  <ReputationAction targettype="Faction" identifier="cdbank" increase="5" />
                  <ConversationAction targettag="triggerer_player" text="存款成功，感谢您使用本银行" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Success>
                <Failure>
                  <ConversationAction targettag="triggerer_player" text="您的钱好像不够呢" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Failure>
              </CheckMoneyAction>
            </Option>
            <Option text="存款十万马克">
              <CheckMoneyAction amount="100000">
                <Success>
                  <MoneyAction amount="-100000" />
                  <ReputationAction targettype="Faction" identifier="cdbank" increase="10" />
                  <ConversationAction targettag="triggerer_player" text="存款成功，感谢您使用本银行" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Success>
                <Failure>
                  <ConversationAction targettag="triggerer_player" text="您的钱好像不够呢" />
                  <ClearTagAction tag="triggerer_player" />
                  <GoTo name="beginningofthejourney" />
                </Failure>
              </CheckMoneyAction>
            </Option>
          </ConversationAction>
        </Option>
        <Option text="等下再来">
          <ConversationAction text="好的，随时欢迎您的光临" dialogtype="Small" targettag="triggerer_player" />
          <ClearTagAction tag="triggerer_player" />
          <GoTo name="beginningofthejourney" />
        </Option>
      </ConversationAction>
      <NPCWaitAction npctag="cdbanker" wait="false" />
    </ScriptedEvent>
